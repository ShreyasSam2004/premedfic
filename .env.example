# ---------------------------------------------------------------------------
# PremedFix AI — environment template. Copy to .env and adjust.
# ---------------------------------------------------------------------------

# Database. Leave DATABASE_URL unset to use embedded PostgreSQL (PGlite)
# persisted at PGLITE_DATA_DIR. Set it to use a real PostgreSQL server,
# e.g. the one in docker-compose.yml:
# DATABASE_URL=postgres://premedfix:premedfix@localhost:5432/premedfix
PGLITE_DATA_DIR=.data/pglite

# Object storage for evidence and import files (local filesystem adapter).
STORAGE_DIR=.data/storage

# Secret used to sign evidence download URLs and portal session cookies.
# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-me-to-a-long-random-string

# Public base URL used when composing portal links in (simulated) notices.
# Links are minted when a notice is approved, including during `npm run db:reset`,
# so this must match the URL/port you serve on BEFORE seeding.
APP_BASE_URL=http://localhost:3000

# Demo mode shows simulated message contents (e.g. portal verification codes)
# on screen, because no real email/SMS provider is connected. Never enable in production.
DEMO_MODE=true

# Optional AI providers. Not required: the deterministic engine is the default.
# No LLM adapter ships in this MVP; see docs/ARCHITECTURE.md (Extraction providers).
# AI_PROVIDER=
